# Deixe vazio quando frontend e API estiverem no mesmo projeto Vercel.
VITE_API_URL=""

# Supabase (Project Settings > API)
SUPABASE_URL="https://xxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key"

# Webhook Payt / Luminar Pay
SALES_WEBHOOK_SECRET="troque-por-um-token-grande"
PAYT_AFFILIATE_EMAILS="email-afiliado-1@exemplo.com,email-afiliado-2@exemplo.com"

# Meta Ads (opcional no primeiro deploy)
FB_ACCESS_TOKEN=""
FB_AD_ACCOUNT_ID="act_000000000000000"
FB_GRAPH_VERSION="v21.0"

# Protege a rotina agendada /api/cron/meta-sync
CRON_SECRET="troque-por-outro-token-grande"
