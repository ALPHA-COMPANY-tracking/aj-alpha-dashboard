# Deixe vazio quando frontend e API estiverem no mesmo projeto Vercel.
VITE_API_URL=""

# Supabase (Project Settings > API)
SUPABASE_URL="https://xxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="cole-a-service-role-key"

# Webhook Payt / Luminar Pay
SALES_WEBHOOK_SECRET="troque-por-um-token-grande"
# E-mail da SUA conta Payt — define seu papel (producer => produtor, affiliation => afiliado)
# em cada venda, pelo array commission[] do postback.
PAYT_OWNER_EMAIL="dermaxpro.oficial@gmail.com"
PAYT_AFFILIATE_EMAILS="email-afiliado-1@exemplo.com,email-afiliado-2@exemplo.com"

# Meta Ads (opcional no primeiro deploy)
FB_ACCESS_TOKEN=""
FB_AD_ACCOUNT_ID="act_000000000000000"
FB_GRAPH_VERSION="v21.0"
META_AD_ACCOUNTS_JSON='[{"bmName":"BM 1","accountId":"act_000000000000000","token":"token-da-bm-1"},{"bmName":"BM 2","accountId":"act_111111111111111","token":"token-da-bm-2"}]'
META_USD_TO_BRL_RATE="5.05"

# Protege a rotina agendada /api/cron/meta-sync
CRON_SECRET="troque-por-outro-token-grande"

# Permite o botão da dashboard disparar /api/meta-sync sem expor tokens da Meta
META_REFRESH_TOKEN="troque-por-token-de-refresh"
VITE_META_REFRESH_TOKEN="mesmo-token-de-refresh"
