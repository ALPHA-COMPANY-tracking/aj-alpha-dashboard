{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/meta-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook/vendas/:token",
      "destination": "/api/webhook/vendas?token=:token"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
