# ---------------------------------------------------------------------------
# Variáveis de ambiente do backend — NUNCA commite o arquivo .env real.
# Copie este arquivo para .env e preencha com os valores reais.
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL (Supabase)
# DATABASE_URL = conexão "pooled" (Transaction pooler, porta 6543) — usada pela app.
# DIRECT_URL   = conexão direta (Session pooler, porta 5432) — usada pelas migrations.
# Pegue as duas em: Supabase > Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# Porta do servidor Express
PORT=3333

# Origem permitida do frontend (CORS)
FRONTEND_ORIGIN="http://localhost:5173"

# --- Meta / Facebook Marketing API ---
# System User Access Token de longa duração (NUNCA exponha no frontend).
FB_ACCESS_TOKEN=""
# ID da conta de anúncios, com o prefixo act_
FB_AD_ACCOUNT_ID="act_000000000000000"
# Versão da Graph API
FB_GRAPH_VERSION="v21.0"
# Fuso da conta de anúncios (para alinhar o "spend" por dia)
FB_ACCOUNT_TIMEZONE="America/Sao_Paulo"

# --- Webhook da plataforma de vendas (Luminar Pay) ---
# Token secreto que vai na URL do webhook. Configure na Luminar Pay a URL:
#   https://SEU_DOMINIO/webhook/vendas/<SALES_WEBHOOK_SECRET>
# Gere algo aleatório e longo (ex.: openssl rand -hex 24).
SALES_WEBHOOK_SECRET="troque-por-um-token-aleatorio-longo"
