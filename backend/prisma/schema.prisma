// Schema do banco de dados — PostgreSQL via Prisma.
// Rode `npm run prisma:migrate` para criar/atualizar as tabelas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão "pooled" (Supabase pooler, porta 6543) usada pela aplicação.
  url       = env("DATABASE_URL")
  // Conexão direta (porta 5432) usada pelas migrations do Prisma.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // hash (bcrypt/argon2) — nunca em texto puro
  createdAt DateTime @default(now())
}

/// Uma linha por dia. Algumas colunas vêm do cron da Meta (gastoAnuncios),
/// outras do webhook (faturamento, vendas, leads), outras manuais.
model DailyMetric {
  id                  String   @id @default(uuid())
  data                DateTime @unique @db.Date
  faturamento         Decimal  @default(0) @db.Decimal(12, 2)
  totalVendas         Int      @default(0)
  leads               Int      @default(0)
  gastoAnuncios       Decimal  @default(0) @db.Decimal(12, 2)
  imposto             Decimal  @default(0) @db.Decimal(12, 2)
  gastosOperacionais  Decimal  @default(0) @db.Decimal(12, 2)
  origemAnuncios      String   @default("sync") // "sync" | "manual"
  updatedAt           DateTime @updatedAt
}

model Sale {
  id          String   @id @default(uuid())
  /// id idempotente vindo da plataforma (evita duplicar no reenvio do webhook)
  externalId  String?  @unique
  valor       Decimal  @db.Decimal(12, 2)
  dataHora    DateTime
  criativoId  String?
  origem      String? // ex.: URL do checkout (link.url)
  gateway     String?  @default("payt") // "payt" | "luminar-pay"
  tipo        String   @default("venda") // "venda" | "lead"
  diaSemana   Int // 0-6
  hora        Int // 0-23
  createdAt   DateTime @default(now())

  @@index([dataHora])
}

model Lead {
  id          String   @id @default(uuid())
  externalId  String?  @unique
  dataHora    DateTime
  origem      String?
  createdAt   DateTime @default(now())

  @@index([dataHora])
}

model OperationalExpense {
  id         String   @id @default(uuid())
  descricao  String
  valor      Decimal  @db.Decimal(12, 2)
  data       DateTime @db.Date
  recorrente Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Creative {
  id               String  @id @default(uuid())
  nome             String
  plataforma       String
  gasto            Decimal @default(0) @db.Decimal(12, 2)
  vendasAtribuidas Int     @default(0)
  status           String  @default("ativo") // ativo | pausado | reprovado
}

model Chip {
  id             String   @id @default(uuid())
  numero         String
  status         String   @default("aquecendo") // aquecendo | ativo | banido | reserva
  dataAquisicao  DateTime @default(now())
  observacao     String?
}

model SpyAd {
  id          String   @id @default(uuid())
  concorrente String
  link        String
  nicho       String?
  anotacao    String?
  salvoEm     DateTime @default(now())
}

/// Linha única de configurações globais.
model Settings {
  id              Int     @id @default(1)
  aliquotaImposto Decimal @default(12.15) @db.Decimal(5, 2)
  impostoAtivo    Boolean @default(true)
  adAccountId     String  @default("")
  /// token criptografado (use uma chave do .env para cifrar/decifrar)
  tokenFacebook   String?
  graphApiVersion String  @default("v21.0")
}
